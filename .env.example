# Database (SQLite default for zero-config local run, or PostgreSQL: postgresql://user:password@localhost:5432/mailpilot)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="mailpilot_super_secret_jwt_key_2026_dev_environment"

# Google OAuth (Optional - add your Google Cloud credentials to enable Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Provider Configuration (Optional: Gemini or OpenAI API key. If empty, MailPilot uses its intelligent built-in heuristic AI engine!)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-3.6-flash"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
